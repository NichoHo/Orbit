# Copy to .env and fill in. Both values are safe to expose — EXPO_PUBLIC_* is
# inlined into the app bundle at build time and readable by anyone with the
# .apk/.ipa. Never put the service_role / secret key here; that belongs in
# `supabase secrets set` for Edge Functions only (blueprint §7).

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
